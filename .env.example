# ————— Base de données (Supabase Postgres) —————
# Utiliser le "connection pooler" de Supabase (port 6543, mode transaction),
# pas la connexion directe (port 5432) — indispensable en serverless (Netlify).
# Supabase Dashboard > Project Settings > Database > Connection string > Transaction pooler
DATABASE_URL="postgresql://postgres.xxxxxxxx:VOTRE_MOT_DE_PASSE@aws-0-xxxx.pooler.supabase.com:6543/postgres"

# ————— Supabase Storage (photos produits envoyées via l'admin) —————
# Project Settings > API
SUPABASE_URL="https://xxxxxxxx.supabase.co"
# Clé "service_role" — SECRÈTE, ne jamais exposer côté navigateur, ne jamais commiter.
SUPABASE_SERVICE_ROLE_KEY="votre-cle-service-role"
SUPABASE_STORAGE_BUCKET="product-images"

# ————— Génération de description produit (Gemini) —————
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY="votre-cle-gemini"
GEMINI_MODEL="gemini-2.5-flash"

# ————— Accès admin (/admin) —————
ADMIN_PASSWORD="choisissez-un-mot-de-passe-fort"
# Chaîne aléatoire longue, générée une seule fois (ex. openssl rand -hex 32)
ADMIN_SESSION_SECRET="une-chaine-aleatoire-longue-et-secrete"

# ————— Adresse du site (pour les aperçus de partage / réseaux sociaux) —————
# L'adresse Netlify de ton site une fois déployé (ex. https://techzone-benin.netlify.app),
# ou ton propre nom de domaine si tu en branches un.
NEXT_PUBLIC_SITE_URL="https://votre-site.netlify.app"
